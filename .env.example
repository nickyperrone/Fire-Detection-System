# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
DATABASE_URL=postgresql+psycopg://fieldwatch:fieldwatch@localhost:5433/fieldwatch
# Email (docs/09-accounts-and-alerts.md). As below: Mailpit from docker compose, at localhost:8025.
APP_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=Field Watch <alerts@fieldwatch.local>
# Real email through Resend instead (the password is a Resend API key; never commit it):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_...
# SMTP_STARTTLS=true
# SMTP_FROM=Field Watch <alerts@your-verified-domain>
TEST_DATABASE_URL=postgresql+psycopg://fieldwatch:fieldwatch@localhost:5433/fieldwatch_test

# Telegram alerts (docs/13-notifications.md#telegram): the token BotFather gives for the bot.
# Empty turns Telegram off.
TELEGRAM_BOT_TOKEN=

# Cloudflare Turnstile on the sign-in form (docs/09-accounts-and-alerts.md#bots). Both empty turn
# the check off. Test keys that always pass: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
