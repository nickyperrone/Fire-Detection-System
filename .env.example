# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
DATABASE_URL=postgresql+psycopg://fieldwatch:fieldwatch@localhost:5433/fieldwatch
# Email (docs/09-accounts-and-alerts.md). Empty: Mailpit from docker compose, at localhost:8025.
APP_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=Field Watch <alerts@fieldwatch.local>
TEST_DATABASE_URL=postgresql+psycopg://fieldwatch:fieldwatch@localhost:5433/fieldwatch_test
